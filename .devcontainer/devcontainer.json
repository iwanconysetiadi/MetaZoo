{
  "name": "MetaZoo",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "MetaZoo dev server",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "npm ci",
  "postAttachCommand": "npm run dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
